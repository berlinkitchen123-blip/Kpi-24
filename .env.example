# Copy to .env.local and fill with the NEW Firebase project's web config.
# These values are public by design; security comes from firestore.rules / storage.rules.
# Leave VITE_FIREBASE_API_KEY empty to run in demo mode (in-memory sample data).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
