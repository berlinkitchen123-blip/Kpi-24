# Copy to .env.local and fill with the NEW Firebase project's web config.
# These values are public by design; security comes from firestore.rules.
# Leave VITE_FIREBASE_API_KEY empty to run in demo mode (in-memory sample data).
# No Firebase Storage bucket: receipts are stored inline in Firestore as compressed base64.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
